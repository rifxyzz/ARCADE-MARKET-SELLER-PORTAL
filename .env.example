# Copy this file to .env and fill the values before deploying.

# Private key of the wallet that will deploy ArcadeMarket.
# Do not commit your real private key.
PRIVATE_KEY=0xyour_private_key_here

# Arc Testnet RPC used by the current seller portal config.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# USDC token on Arc Testnet.
# If you only need listing tests first, this can remain zero address until purchase flow needs real USDC.
USDC_TOKEN=0x0000000000000000000000000000000000000000

# Genesis NFT contract used for on-chain seller gating.
# Use zero address + MIN_NFT_BALANCE=0 to disable on-chain gating for testing.
GENESIS_NFT=0x0000000000000000000000000000000000000000
MIN_NFT_BALANCE=0

# Platform fee in basis points. 0 = no fee. 250 = 2.5%.
PLATFORM_FEE_BPS=0

# Wallet receiving platform fee. Defaults to deployer if omitted.
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
